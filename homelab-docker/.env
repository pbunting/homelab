# Host folder on the mounted disk that holds all persistent data.
# Use an absolute path, e.g. /Volumes/data/infra (macOS) or /mnt/data/infra (Linux).
DATA_DIR=./data

# Host ports (5000 is taken by AirPlay Receiver on macOS, hence 5050)
REGISTRY_PORT=5050
GRAFANA_PORT=3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

METRICS_RETENTION=15d
